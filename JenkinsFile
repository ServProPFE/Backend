pipeline{
    agent any
    stages{
        stage('Checkout'){
            steps{
                echo 'Repo Checkout...'
                git('https://github.com/ServProPFE/Backend/main')
            }
        }
        stage('Install Dependencies'){
            steps{
                echo 'Installing dependencies...'
                bat 'npm install'
            }
        }
        stage('Test'){
            steps{
                echo 'Running tests...'
                bat 'npm run test:coverage'
            }
        }
        stage('Dockerisation'){
            steps{
                echo 'Dockerising the application...'
                // Add Dockerisation steps here
                bat 'docker compose up -d'
            }
        }
    }
}